---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0">
    <channel>
        <title>Karhukarhu Blog</title>
        <link>https://karhukarhu.place/blog</link>
        
        {% assign sorted_posts = collections.post | reverse %}
        {% for post in sorted_posts %}
        <item>
            <title>{{ post.data.title | xml_escape }}</title>
            <description>{{ post.data.description | default: post.templateContent | strip_html | truncate: 300 | xml_escape }}</description>
            <link>https://karhukarhu.place{{ post.url }}</link>
            <guid>{{ post.date | date: "%Y%m%d" }}{{ post.page.fileSlug }}</guid>
            <pubDate>{{ post.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
        </item>
        {% endfor %}
    </channel>
</rss>