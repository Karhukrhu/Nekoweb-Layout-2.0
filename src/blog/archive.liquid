---
title: Blog
layout: base
pagination:
  data: collections.post
  size: 5
  alias: posts
  reverse: true
---

<h3>Post Archive</h3>

{% for post in posts %}

  <div class="post-list-wrapper">
    <div class="post-header">
      
      <!-- 1. THE WARNING SIGN (Now placed FIRST, so it appears in front) -->
      {% if post.data.warning %}
        <span class="post-warning" data-tooltip="{{ post.data.warning }}">
          <svg class="warning" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
            <path d="M256 0c14.7 0 28.2 8.1 35.2 21l216 400c6.7 12.4 6.4 27.4-.8 39.5S486.1 480 472 480L40 480c-14.1 0-27.2-7.4-34.4-19.5s-7.5-27.1-.8-39.5l216-400c7-12.9 20.5-21 35.2-21zm0 352a32 32 0 1 0 0 64 32 32 0 1 0 0-64zm0-192c-18.2 0-32.7 15.5-31.4 33.7l7.4 104c.9 12.5 11.4 22.3 23.9 22.3 12.6 0 23-9.7 23.9-22.3l7.4-104c1.3-18.2-13.1-33.7-31.4-33.7z"/>
          </svg>
        </span>
      {% endif %}

      <!-- 2. The Post Title Link -->
      <a class="post-title" href="{{ post.url }}">{{ post.data.title }}</a> 
      
      <!-- 3. The Date -->
      <div class="post-date">{{ post.date | niceDate }}</div> 
      
    </div>
  
    {{ post.data.description }}
  </div>

{% endfor %}

<p>
{% if pagination.href.previous %}
<a href=" {{ pagination.href.previous }}">Previous</a>
{% else %}
Previous
{% endif %} 
/ 
{% if pagination.href.next %}
<a href=" {{ pagination.href.next }}">Next</a>
{% else %}
Next
{% endif %}
</p>