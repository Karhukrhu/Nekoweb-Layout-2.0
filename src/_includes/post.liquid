---
layout: base
---

<h2>Blog</h2>

<div class="post-header">
  
  <!-- 1. THE WARNING SIGN (Placed first, so it appears in front of the title) -->
  {% if warning %}
    <span class="post-warning" data-tooltip="{{ warning }}">
      <svg class="warning" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
        <path d="M256 0c14.7 0 28.2 8.1 35.2 21l216 400c6.7 12.4 6.4 27.4-.8 39.5S486.1 480 472 480L40 480c-14.1 0-27.2-7.4-34.4-19.5s-7.5-27.1-.8-39.5l216-400c7-12.9 20.5-21 35.2-21zm0 352a32 32 0 1 0 0 64 32 32 0 1 0 0-64zm0-192c-18.2 0-32.7 15.5-31.4 33.7l7.4 104c.9 12.5 11.4 22.3 23.9 22.3 12.6 0 23-9.7 23.9-22.3l7.4-104c1.3-18.2-13.1-33.7-31.4-33.7z"/>
      </svg>
    </span>
  {% endif %}

  <!-- 2. The Post Title -->
  <h3 class="post-single-title">{{ title }}</h3> 
  
  <!-- 3. The Date -->
  <div class="post-date">{{ date | niceDate }}</div>
</div>

{{ content }}

<div class="button-wrapper"> Like this post →
<button id="like-btn" class="like-button">
  <span class="like-heart">
    <!-- Unliked state: outline heart SVG -->
    <svg id="heart-outline" class="heart-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
    <!-- Liked state: filled heart SVG (hidden by default) -->
    <svg id="heart-filled" class="heart-svg" style="display: none;" viewBox="0 0 24 24" fill="currentColor" stroke="none">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
  </span>
  <span id="like-count" class="like-count">0</span>
</button>
</div>

{% raw %}
<script>
  const API = 'https://www.likeslikes.net';
  const url = window.location.href;
  const btn = document.getElementById('like-btn');
  const count = document.getElementById('like-count');
  const heartOutline = document.getElementById('heart-outline');
  const heartFilled = document.getElementById('heart-filled');

  fetch(`${API}/api/v1/likes?url=${encodeURIComponent(url)}`)
    .then(r => r.json())
    .then(({ data }) => {
      count.textContent = data.likes;
      if (data.is_liked) {
        btn.disabled = true;
        heartOutline.style.display = 'none';
        heartFilled.style.display = 'block';
      }
    })
    .catch(err => {
      console.error('Error fetching likes:', err);
      count.textContent = '0';
    });

  btn.addEventListener('click', () => {
    fetch(`${API}/api/v1/likes`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url })
    })
      .then(r => r.json())
      .then(({ data }) => {
        if (data.success) {
          count.textContent = data.likes;
          heartOutline.style.display = 'none';
          heartFilled.style.display = 'block';
          btn.disabled = true;
        }
      })
      .catch(err => console.error('Error liking:', err));
  });
</script>
{% endraw %}

<!-- CATEGORIES -->
<p class="sml">
  {% for cat in categories %}
    <a href="/blog/categories/{{ cat | slugify }}">{{ cat }}</a>{% unless forloop.last %} {% endunless %}
  {% endfor %}
</p>

<!-- Post Navigation -->
{% assign previousPost = collections.post | getPreviousCollectionItem %}
{% assign nextPost = collections.post | getNextCollectionItem %}

<div class="post-navigation">
  {% if previousPost %}
    <a href="{{ previousPost.url }}" class="nav-link prev">
      ← Previous
    </a>
  {% else %}
    <div></div>
  {% endif %}

  {% if nextPost %}
    <a href="{{ nextPost.url }}" class="nav-link next">
      Next →
    </a>
  {% endif %}
</div>

<section id="comments" style="margin-top:50px">
  <h3>Leave a Comment</h3>
  <p class="sml">Note that your comment appears only after I have approved it.</p>
<form id="c_form" action="https://api.web3forms.com/submit" method="POST" onsubmit="submitForm(event)">
  
  <input type="hidden" name="access_key" value="36606ee4-364b-486f-9615-60ce6b9c6694">
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
  <input type="hidden" name="Post_URL" value="{{ page.url }}">
  <input type="hidden" name="Post_Title" value="{{ title }}">

  <div id="c_nameWrapper" class="c-inputWrapper c-form-row">
    <label class="c-label" for="c-name">Name</label>
    <input class="c-input" id="c-name" type="text" name="name" required />
  </div>

  <div id="c_websiteWrapper" class="c-inputWrapper c-form-row">
    <label class="c-label" for="c-website">Website (Optional)</label>
    <input class="c-input" id="c-website" type="url" name="website" placeholder="https://example.com" />
  </div>

  <div id="c_textWrapper" class="c-inputWrapper c-form-row">
    <label class="c-label" for="c-message">Message</label>
    <textarea class="c-input" id="c-message" name="message" rows="4" maxlength="600" required></textarea>
  </div>

  <div class="c-button-wrapper">
    <button id="c_submitButton" type="submit">Submit</button>
  </div>
  
  <div id="c_successMessage" style="display: none;">
    Thank you for your comment! It will appear after approval.
  </div>
</form>
</section>

<section id="approved-comments">
  {% assign page_comments = comments | where: "slug", page.fileSlug %}

  {% if page_comments.size > 0 %}
    {% for comment in page_comments %}
      {% unless comment.is_author %}
        <div class="c-comment" id="comment-{{ forloop.index }}">
          <div class="c-name" style="display:inline-block;">{{ comment.name }}</div>
          {% if comment.website %}
            <a href="{{ comment.website }}" target="_blank" rel="noopener noreferrer" class="c-site">website</a>
          {% endif %}
          <span class="c-timestamp">{{ comment.date }}</span>
          <div class="c-text">{{ comment.comment }}</div>
        </div>
      {% endunless %}
    {% endfor %}

    {% for comment in page_comments %}
      {% if comment.is_author %}
        <div class="c-replyContainer">
          <div class="c-reply">
            <div class="c-reply-header">
              <div class="c-replyname" style="display:inline-block;">{{ comment.name }}</div>
              <span class="c-timestamp">{{ comment.date }}</span>
            </div>
            <div class="c-replytext-wrapper">
              <div class="c-replytext-arrow">⤷</div><div class="c-replytext">{{ comment.comment }}</div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% else %}
    <p class="sml">No comments yet. Be the first to leave one!</p>
  {% endif %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const successMsg = document.querySelector('#c_successMessage');
    if (successMsg) {
      successMsg.style.display = 'none';
    }
  });

  async function submitForm(event) {
    event.preventDefault();
    const form = event.target;
    const submitBtn = form.querySelector('#c_submitButton');
    const successMsg = form.querySelector('#c_successMessage');
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
    
    const formData = new FormData(form);
    
    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });
      
      const result = await response.json();
      
      if (result.success) {
        form.querySelector('#c_nameWrapper').style.display = 'none';
        form.querySelector('#c_websiteWrapper').style.display = 'none';
        form.querySelector('#c_textWrapper').style.display = 'none';
        submitBtn.style.display = 'none';
        successMsg.style.display = 'block';
      } else {
        alert('Something went wrong. Please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit';
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Something went wrong. Please try again.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit';
    }
  }
</script>